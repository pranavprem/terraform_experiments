# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# .tfvars files are the place for environment-specific values. Keep them local.
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Plan output can contain sensitive values
*.tfplan
*tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

# .terraform.lock.hcl is committed on purpose. Do not add it here.

# Local backend settings copied from backend.hcl.example
backend.hcl

# Private keys written by simple_server/ssh_to_host.sh
*.pem
